# Run the API in production mode.
APP_ENV=production
# Set to a random secret of at least 32 characters.
JWT_SECRET=replace-with-32-or-more-random-characters
# Set to the exact Vercel origin, without a trailing slash.
CORS_ORIGINS=https://your-project.vercel.app
# Trust Render's forwarded client IP header.
TRUST_PROXY=1
# Disable ChromaDB for this deployment.
USE_CHROMA=0
# Cloud AI provider: claude, groq, or openrouter.
CLOUD_PROVIDER=claude
# Set this or GROQ_API_KEY to the key for your selected provider.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Set this or ANTHROPIC_API_KEY to the key for your selected provider.
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional database URL; unset it to use the local SQLite default.
DATABASE_URL=sqlite:///./vouchly.db
